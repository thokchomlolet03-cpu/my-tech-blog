---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <!-- MkDocs Slate Hero Section -->
    <section id="hero" class="doc-card relative mb-6 p-5 sm:p-6">
      <div
        class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-[rgba(230,235,245,0.12)] pb-2.5"
      >
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-[#a47bea]"></span>
          <span
            class="font-mono text-[10px] font-medium tracking-widest text-[#a47bea] uppercase"
          >
            System Architecture &amp; AI Engineering
          </span>
        </div>
        <span
          class="rounded border border-[rgba(230,235,245,0.12)] bg-[#282c35] px-2 py-0.5 font-mono text-[10px] text-[#9ba0ad]"
        >
          EDITION: 2026.08
        </span>
      </div>

      <div class="my-1.5 flex items-center gap-3">
        <h1
          class="font-sans text-2xl font-bold tracking-tight text-white sm:text-3xl"
        >
          Friction Hunter
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block rounded-md border border-[rgba(230,235,245,0.12)] bg-[#282c35] p-1.5 text-[#a47bea] transition-all hover:border-[#a47bea] hover:text-white"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={14}
            height={14}
            class="stroke-accent stroke-2 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-2 font-sans text-sm leading-relaxed text-[#dce0e8]">
        Welcome to <strong class="font-semibold text-white"
          >Friction Hunter</strong
        > — an engineering publication by <strong
          class="font-medium text-[#a47bea]">Thokchom Lolet Singh</strong
        > investigating client-side WebGPU architectures, transformer sampling thermodynamics,
        edge-AI state machines, and incident post-mortems.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-[rgba(230,235,245,0.12)] pt-3 font-sans text-xs text-[#9ba0ad]">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-[#a47bea]">&gt;</span>
              <span>Connect:</span>
              <Socials />
            </div>
            <span class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-400">
              <span class="size-1.5 rounded-full bg-emerald-400" />
              ALL_SYSTEMS_OPERATIONAL
            </span>
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mb-8">
          <div class="mb-3 flex items-center justify-between border-b border-[rgba(230,235,245,0.10)] pb-2">
            <h2 class="flex items-center gap-2 font-sans text-sm font-bold tracking-tight text-white">
              <span class="font-mono text-xs text-[#a47bea]">//</span>
              <span>{t.home.featured}</span>
            </h2>
            <span class="font-mono text-[10px] text-[#9ba0ad]">
              {featuredPosts.length} Articles
            </span>
          </div>
          <ul class="divide-y-0">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-8">
          <div class="mb-3 flex items-center justify-between border-b border-[rgba(230,235,245,0.10)] pb-2">
            <h2 class="flex items-center gap-2 font-sans text-sm font-bold tracking-tight text-white">
              <span class="font-mono text-xs text-[#a47bea]">//</span>
              <span>{t.home.recentPosts}</span>
            </h2>
            <span class="font-mono text-[10px] text-[#9ba0ad]">Latest</span>
          </div>
          <ul class="divide-y-0">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="doc-badge inline-flex items-center gap-2 px-5 py-2.5 text-sm transition-all hover:border-[#a47bea] hover:text-white"
      >
        <span>{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
