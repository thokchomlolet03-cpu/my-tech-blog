---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// Grouping by Format and Domain
const blueprints = sortedPosts.filter(
  ({ data }) => data.format === "blueprint"
);
const breakdowns = sortedPosts.filter(
  ({ data }) => data.format === "breakdown" && !data.series
);
const fieldNotes = sortedPosts.filter(
  ({ data }) => data.format === "field-note"
);

const infraPosts = sortedPosts.filter(
  ({ data }) => data.domain === "infrastructure"
);
const aiPosts = sortedPosts.filter(({ data }) => data.domain === "ai-systems");
const systemsPosts = sortedPosts.filter(
  ({ data }) => data.domain === "systems"
);
const humanPosts = sortedPosts.filter(({ data }) => data.domain === "human");

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full space-y-8"
  >
    <!-- Master Hero Hub Section -->
    <section
      id="hero"
      class="doc-card relative overflow-hidden rounded-2xl border border-gray-800 bg-gray-950 p-6 sm:p-8"
    >
      <div
        class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-[rgba(230,235,245,0.12)] pb-3"
      >
        <div class="flex items-center gap-2">
          <span class="size-2 animate-pulse rounded-full bg-emerald-400"></span>
          <span
            class="font-mono text-xs font-bold tracking-widest text-emerald-400 uppercase"
          >
            Engineering Hub &amp; First-Principles Research
          </span>
        </div>
        <span
          class="rounded border border-gray-800 bg-gray-900 px-2.5 py-0.5 font-mono text-[10px] text-gray-400"
        >
          24 RESEARCH PAPERS &bull; 4 DOMAINS
        </span>
      </div>

      <div
        class="my-2 flex flex-col justify-between gap-4 md:flex-row md:items-center"
      >
        <div>
          <h1
            class="font-sans text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
          >
            Thokchom Lolet Singh
          </h1>
          <p class="mt-1 font-mono text-sm text-purple-400">
            Infrastructure &bull; Autonomous AI Systems &bull; Low-Level
            Compilers
          </p>
        </div>

        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-flex items-center gap-2 self-start rounded-lg border border-gray-800 bg-gray-900 px-3 py-1.5 font-mono text-xs text-purple-300 transition hover:border-purple-500 hover:text-white md:self-auto"
          aria-label="RSS Feed"
        >
          <IconRss
            width={14}
            height={14}
            class="stroke-accent stroke-2 rtl:-rotate-90"
          />
          <span>RSS Feed</span>
        </a>
      </div>

      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-gray-300">
        A structured research and engineering platform documenting the mechanics
        of cloud orchestration, deterministic 3-way reconciliation, biophysical
        discovery compilers, and client-side WebAssembly execution.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[rgba(230,235,245,0.12)] pt-4 font-sans text-xs text-gray-400">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-purple-400">&gt;</span>
              <span>Connect:</span>
              <Socials />
            </div>
            <span class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-400">
              <span class="size-1.5 rounded-full bg-emerald-400" />
              GCP_GLOBAL_CDN_DEPLOYED
            </span>
          </div>
        )
      }
    </section>

    <!-- Pinned Engineering Journey Hero Card -->
    <section
      id="featured-journey"
      class="relative rounded-2xl border border-amber-500/40 bg-gradient-to-r from-amber-950/40 via-gray-900 to-gray-950 p-6 shadow-2xl sm:p-8"
    >
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <span
          class="inline-flex items-center gap-1 rounded-full border border-amber-500/40 bg-amber-500/20 px-2.5 py-0.5 font-mono text-xs font-bold tracking-wider text-amber-300 uppercase"
        >
          🗺️ FEATURED CURRICULUM JOURNEY
        </span>
        <span class="font-mono text-xs font-bold text-amber-400"
          >12 COMPREHENSIVE MODULES</span
        >
      </div>

      <h2
        class="text-2xl leading-snug font-extrabold tracking-tight text-white sm:text-3xl"
      >
        True Mastery of Terraform: A First-Principles Journey
      </h2>

      <p class="mt-2 max-w-3xl font-sans text-sm leading-relaxed text-gray-300">
        From quartz crystal timer interrupts (`IRQ 0`) and Go AST scope
        resolution to the 3-Way Merge ($D \times P \times R$), Protocol v6 gRPC
        provider plugins, and the "Scaffold & Shatter" pedagogical framework.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a
          href="/posts/true-mastery-of-terraform-first-principles-journey/"
          class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-5 py-2.5 text-xs font-extrabold tracking-wide text-black uppercase shadow-lg shadow-amber-500/20 transition hover:bg-amber-400"
        >
          <span>Start Curriculum Hub</span>
          <IconArrowRight class="h-3.5 w-3.5" />
        </a>

        <a
          href="/posts/terraform-mastery-01-physical-and-os-foundations/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-gray-800 bg-gray-900 px-4 py-2.5 text-xs font-bold text-gray-200 transition hover:bg-gray-800"
        >
          <span>Begin Module 01: Physical &amp; OS Reality &rarr;</span>
        </a>
      </div>
    </section>

    <!-- Domain Taxonomy Grid Lanes -->
    <section id="taxonomy-lanes" class="space-y-6">
      <div
        class="flex items-center justify-between border-b border-gray-800 pb-2"
      >
        <h2
          class="flex items-center gap-2 font-mono text-base font-extrabold text-white"
        >
          <span class="text-purple-400">//</span>
          <span>EXPLORE BY ENGINEERING DOMAIN</span>
        </h2>
        <span class="font-mono text-xs text-gray-500">4 CORE DOMAINS</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Infrastructure Lane -->
        <div
          class="flex flex-col justify-between space-y-3 rounded-xl border border-gray-800 bg-gray-900 p-5"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xl">🌐</span>
              <span
                class="rounded border border-emerald-800 bg-emerald-950 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-400"
              >
                {infraPosts.length} POSTS
              </span>
            </div>
            <h3 class="text-sm font-bold text-white">
              Infrastructure &amp; Cloud
            </h3>
            <p class="text-xs leading-relaxed text-gray-400">
              Terraform internals, GitOps pipelines, state reconciliation, and
              $0.00 cloud architectures.
            </p>
          </div>
          <span class="font-mono text-[11px] font-bold text-emerald-400"
            >&bull; 12 Modules &amp; Hub</span
          >
        </div>

        <!-- Applied AI Lane -->
        <div
          class="flex flex-col justify-between space-y-3 rounded-xl border border-gray-800 bg-gray-900 p-5"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xl">🧠</span>
              <span
                class="rounded border border-purple-800 bg-purple-950 px-2 py-0.5 font-mono text-[10px] font-bold text-purple-400"
              >
                {aiPosts.length} POSTS
              </span>
            </div>
            <h3 class="text-sm font-bold text-white">
              Applied AI &amp; Autonomous
            </h3>
            <p class="text-xs leading-relaxed text-gray-400">
              Project Mangal, Universal Inverse Design, Socratic AST engines,
              and Friction Hunter.
            </p>
          </div>
          <span class="font-mono text-[11px] font-bold text-purple-400"
            >&bull; 6 Blueprints</span
          >
        </div>

        <!-- Systems Engineering Lane -->
        <div
          class="flex flex-col justify-between space-y-3 rounded-xl border border-gray-800 bg-gray-900 p-5"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xl">⚡</span>
              <span
                class="rounded border border-cyan-800 bg-cyan-950 px-2 py-0.5 font-mono text-[10px] font-bold text-cyan-400"
              >
                {systemsPosts.length} POSTS
              </span>
            </div>
            <h3 class="text-sm font-bold text-white">Systems Engineering</h3>
            <p class="text-xs leading-relaxed text-gray-400">
              Token Cosmos WebGPU runtimes, client-side Wasm, and zero-egress
              prompt linters.
            </p>
          </div>
          <span class="font-mono text-[11px] font-bold text-cyan-400"
            >&bull; 4 Deep Dives</span
          >
        </div>

        <!-- Human Layer Lane -->
        <div
          class="flex flex-col justify-between space-y-3 rounded-xl border border-gray-800 bg-gray-900 p-5"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xl">🧭</span>
              <span
                class="rounded border border-amber-800 bg-amber-950 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-400"
              >
                {humanPosts.length} POSTS
              </span>
            </div>
            <h3 class="text-sm font-bold text-white">The Human Layer</h3>
            <p class="text-xs leading-relaxed text-gray-400">
              Engineering philosophy, language acquisition, and cognitive load
              theory.
            </p>
          </div>
          <span class="font-mono text-[11px] font-bold text-amber-400"
            >&bull; Philosophy &amp; Notes</span
          >
        </div>
      </div>
    </section>

    <!-- Architecture Blueprints Section -->
    <section id="blueprints" class="space-y-4">
      <div
        class="flex items-center justify-between border-b border-gray-800 pb-2"
      >
        <h2
          class="flex items-center gap-2 font-mono text-sm font-bold text-white"
        >
          <span class="text-purple-400">📐</span>
          <span>SYSTEM ARCHITECTURE BLUEPRINTS</span>
        </h2>
        <span class="font-mono text-[10px] text-gray-400"
          >{blueprints.length} Articles</span
        >
      </div>
      <ul class="divide-y-0">
        {blueprints.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>

    <!-- First-Principles Breakdowns & Field Notes Section -->
    <section id="recent-articles" class="space-y-4">
      <div
        class="flex items-center justify-between border-b border-gray-800 pb-2"
      >
        <h2
          class="flex items-center gap-2 font-mono text-sm font-bold text-white"
        >
          <span class="text-teal-400">🔬</span>
          <span>FIRST-PRINCIPLES BREAKDOWNS &amp; FIELD NOTES</span>
        </h2>
        <span class="font-mono text-[10px] text-gray-400"
          >{breakdowns.length + fieldNotes.length} Articles</span
        >
      </div>
      <ul class="divide-y-0">
        {
          [...breakdowns, ...fieldNotes]
            .slice(0, 6)
            .map(data => <Card variant="h3" {...data} />)
        }
      </ul>
    </section>

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="doc-badge inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm transition-all hover:border-purple-400 hover:text-white"
      >
        <span>View Complete 24-Article Archive</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
