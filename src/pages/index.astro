---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <!-- MkDocs Slate Hero Section -->
    <section id="hero" class="doc-card p-5 sm:p-6 mb-6 relative">
      <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 mb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-sky-400"></span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-sky-400 font-medium">
            System Architecture &amp; AI Engineering
          </span>
        </div>
        <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-500 border border-slate-700">
          EDITION: 2026.08
        </span>
      </div>

      <div class="flex items-center gap-3 my-1.5">
        <h1 class="font-sans text-2xl sm:text-3xl font-bold tracking-tight text-white">
          Friction Hunter
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block p-1.5 rounded-md bg-slate-800/80 border border-slate-700 text-sky-400 hover:text-white hover:border-slate-600 transition-all"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={14}
            height={14}
            class="stroke-accent stroke-2 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="text-sm text-slate-300 leading-relaxed font-sans mt-2">
        Welcome to <strong class="text-white font-semibold">Friction Hunter</strong> — an engineering publication by <strong class="text-sky-400 font-medium">Thokchom Lolet Singh</strong> investigating client-side WebGPU architectures, transformer sampling thermodynamics, edge-AI state machines, and incident post-mortems.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 font-sans text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-sky-400 font-mono text-xs">&gt;</span>
              <span>Connect:</span>
              <Socials />
            </div>
            <span class="text-emerald-400 flex items-center gap-1.5 font-mono text-[11px]">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              ALL_SYSTEMS_OPERATIONAL
            </span>
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="mb-8"
        >
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-800/60">
            <h2 class="font-sans text-sm font-bold tracking-tight text-white flex items-center gap-2">
              <span class="text-sky-400 font-mono text-xs">//</span>
              <span>{t.home.featured}</span>
            </h2>
            <span class="font-mono text-[10px] text-slate-600">{featuredPosts.length} Articles</span>
          </div>
          <ul class="divide-y-0">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-8">
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-800/60">
            <h2 class="font-sans text-sm font-bold tracking-tight text-white flex items-center gap-2">
              <span class="text-sky-400 font-mono text-xs">//</span>
              <span>{t.home.recentPosts}</span>
            </h2>
            <span class="font-mono text-[10px] text-slate-600">Latest</span>
          </div>
          <ul class="divide-y-0">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton 
        href={getRelativeLocaleUrl(locale, "posts")}
        class="doc-badge text-sm px-5 py-2.5 hover:border-sky-500 hover:text-white transition-all inline-flex items-center gap-2"
      >
        <span>{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
