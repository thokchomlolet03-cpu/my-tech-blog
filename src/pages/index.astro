---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <!-- HUD Hero Section -->
    <section id="hero" class="hud-card p-6 sm:p-8 mb-8 relative overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-[rgba(0,240,255,0.15)]">
        <div class="flex items-center gap-2">
          <span class="size-2.5 rounded-full bg-[#00f0ff] shadow-[0_0_8px_#00f0ff] animate-pulse"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-[#00f0ff]">
            // SPATIAL TELEMETRY &amp; AI SYSTEMS
          </span>
        </div>
        <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[rgba(0,240,255,0.06)] text-[#00f0ff]/80 border border-[rgba(0,240,255,0.2)]">
          NODE: RUNTIME_V6.0
        </span>
      </div>

      <div class="flex items-center gap-3 my-2">
        <h1 class="font-mono text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Friction Hunter
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block p-1.5 rounded-md bg-[rgba(0,240,255,0.08)] border border-[rgba(0,240,255,0.25)] text-[#00f0ff] hover:border-cyan-400 hover:shadow-[0_0_10px_rgba(0,240,255,0.4)] transition-all"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={16}
            height={16}
            class="stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans mt-3">
        Welcome to <strong class="text-white font-semibold">Friction Hunter</strong> — an engineering publication by <strong class="text-[#00f0ff] font-medium">Thokchom Lolet Singh</strong> investigating client-side WebGPU architectures, transformer sampling thermodynamics, edge-AI state machines, and incident post-mortems.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-6 pt-4 border-t border-[rgba(0,240,255,0.1)] flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-[#00f0ff]">&gt;</span>
              <span>CONNECT_NODES:</span>
              <Socials />
            </div>
            <span class="text-emerald-400 flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              ALL_SYSTEMS_GO
            </span>
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="mb-10"
        >
          <div class="flex items-center justify-between pb-2 mb-4 border-b border-[rgba(0,240,255,0.2)]">
            <h2 class="font-mono text-lg font-bold uppercase tracking-wider text-slate-100 flex items-center gap-2">
              <span class="text-[#00f0ff]">//</span>
              <span>{t.home.featured}</span>
            </h2>
            <span class="font-mono text-xs text-slate-500">COUNT: {featuredPosts.length}</span>
          </div>
          <ul class="space-y-4">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-10">
          <div class="flex items-center justify-between pb-2 mb-4 border-b border-[rgba(0,240,255,0.2)]">
            <h2 class="font-mono text-lg font-bold uppercase tracking-wider text-slate-100 flex items-center gap-2">
              <span class="text-[#00f0ff]">//</span>
              <span>{t.home.recentPosts}</span>
            </h2>
            <span class="font-mono text-xs text-slate-500">RECENT</span>
          </div>
          <ul class="space-y-4">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton 
        href={getRelativeLocaleUrl(locale, "posts")}
        class="hud-badge text-sm px-5 py-2.5 hover:border-cyan-400 hover:shadow-[0_0_15px_rgba(0,240,255,0.3)] transition-all inline-flex items-center gap-2"
      >
        <span>{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
