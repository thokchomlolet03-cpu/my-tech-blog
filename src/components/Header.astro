---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="fixed top-0 z-50 w-full bg-[#7e56c2] text-white shadow-md transition-colors"
>
  <div
    class="relative flex w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 items-center justify-between py-3 h-16"
  >
    <!-- Brand Title -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="flex items-center gap-2.5 font-sans text-lg font-bold tracking-tight text-white hover:opacity-90 transition-opacity"
    >
      <div class="size-7 rounded bg-white/20 flex items-center justify-center text-white text-xs font-mono font-bold">
        FH
      </div>
      <span class="text-white">{site.title}</span>
    </a>

    <!-- Translucent Search Pill (Desktop) -->
    {
      features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class="hidden md:flex items-center justify-between gap-3 px-4 py-1.5 w-64 lg:w-80 rounded-full bg-white/20 hover:bg-white/25 text-white placeholder-white/70 transition-all text-xs font-sans"
        >
          <div class="flex items-center gap-2">
            <IconSearch class="size-4 text-white/80" />
            <span class="text-white/90">Search docs...</span>
          </div>
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-black/20 rounded text-white/90">
            ⌘K
          </kbd>
        </a>
      )
    }

    <!-- Navigation Menu -->
    <nav
      id="nav-menu"
      class="flex items-center sm:space-x-1"
    >
      <button
        id="menu-btn"
        class="focus-outline p-2 sm:hidden text-white hover:opacity-80"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden size-6" />
        <IconMenuDeep id="menu-icon" class="size-6" />
      </button>

      <ul
        id="menu-items"
        class="font-sans text-sm font-medium mt-4 sm:mt-0 hidden absolute sm:static top-full left-0 w-full sm:w-auto bg-[#673ab6] sm:bg-transparent border-b sm:border-0 border-white/20 p-4 sm:p-0 sm:flex sm:items-center sm:gap-1 shadow-lg sm:shadow-none"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "block px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors",
              { "text-white font-semibold bg-white/20": isActive("/posts") }
            ]}
          >
            Posts
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags/post-mortem")}
            class:list={[
              "block px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors",
              { "text-white font-semibold bg-white/20": isActive("/tags/post-mortem") }
            ]}
          >
            Post-Mortems
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={[
              "block px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors",
              { "text-white font-semibold bg-white/20": isActive("/tags") && !isActive("/tags/post-mortem") }
            ]}
          >
            Tags
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "topics")}
            class:list={[
              "block px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors",
              { "text-white font-semibold bg-white/20": isActive("/topics") }
            ]}
          >
            Topics
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "block px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors",
              { "text-white font-semibold bg-white/20": isActive("/about") }
            ]}
          >
            About
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline flex items-center justify-center px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15",
                  { "text-white bg-white/20": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="size-4" />
                <span class="sm:sr-only ml-2 sm:ml-0">{t.nav.archives}</span>
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="md:hidden">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={[
                  "focus-outline flex items-center justify-center px-3 py-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15",
                  { "text-white bg-white/20": isActive("/search") }
                ]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="size-4" />
                <span class="ml-2">{t.nav.search}</span>
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                class="focus-outline p-1.5 rounded-md text-white/90 hover:text-white hover:bg-white/15 transition-colors"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90 hidden dark:block" />
                <IconSunHigh class="size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0 block dark:hidden" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  // Keyboard shortcut listener for Command+K / Ctrl+K search
  function setupSearchShortcut() {
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        const searchLink = document.querySelector<HTMLAnchorElement>("a[href*='/search']");
        if (searchLink) {
          searchLink.click();
        }
      }
    });
  }

  toggleNav();
  setupSearchShortcut();

  document.addEventListener("astro:after-swap", () => {
    toggleNav();
    setupSearchShortcut();
  });
</script>
