---
interface Props {
  series?: string;
  seriesOrder?: number;
  seriesTotal?: number;
}

const { series, seriesOrder = 0, seriesTotal = 12 } = Astro.props;

if (!series) {
  return null;
}

const MODULE_TITLES = [
  {
    order: 0,
    title: "Master Hub & Interactive Curriculum",
    slug: "true-mastery-of-terraform-first-principles-journey",
  },
  {
    order: 1,
    title: "Module 01: Automation & Control-Plane Foundations",
    slug: "terraform-mastery-01-physical-and-os-foundations",
  },
  {
    order: 2,
    title: "Module 02: Terraform Core Architecture & Internals",
    slug: "terraform-mastery-02-core-engine-ast-grpc",
  },
  {
    order: 3,
    title: "Module 03: Planning, Provider Lifecycle & Execution",
    slug: "terraform-mastery-03-reconciliation-3-way-merge",
  },
  {
    order: 4,
    title: "Module 04: Language, Identity, Types & Expressions",
    slug: "terraform-mastery-04-hcl-grammar-cartesian-matrix",
  },
  {
    order: 5,
    title: "Module 05: State, Locking, Drift & Sensitive Data",
    slug: "terraform-mastery-05-state-locking-s3-dynamodb",
  },
  {
    order: 6,
    title: "Module 06: Lifecycle, Replacement & Failure Prevention",
    slug: "terraform-mastery-06-lifecycle-forcenew-outage-prevention",
  },
  {
    order: 7,
    title: "Module 07: State Operations, Refactoring, Import & Recovery",
    slug: "terraform-mastery-07-state-manipulation-extreme-surgery",
  },
  {
    order: 8,
    title: "Module 08: Production Architecture & Enterprise Design",
    slug: "terraform-mastery-08-production-testing-terragrunt",
  },
  {
    order: 9,
    title: "Module 09: Terraform Associate 004 Mastery",
    slug: "terraform-mastery-09-associate-004-exam-drills",
  },
  {
    order: 10,
    title: "Module 10: Hands-On Breakdown Labs",
    slug: "terraform-mastery-10-hands-on-breakdown-labs",
  },
  {
    order: 11,
    title: "Module 11: Custom Provider Development",
    slug: "terraform-mastery-11-custom-go-provider-development",
  },
  {
    order: 12,
    title: "Module 12: Cost-Aware Cloud Hosting & Global Access",
    slug: "terraform-mastery-12-zero-cost-gcp-cloud-architecture",
  },
];

const prevModule = MODULE_TITLES.find(m => m.order === seriesOrder - 1);
const nextModule = MODULE_TITLES.find(m => m.order === seriesOrder + 1);
const progressPercent = Math.round((seriesOrder / seriesTotal) * 100);
---

<div
  class="not-prose my-8 rounded-2xl border border-amber-500/30 bg-gray-950 p-5 font-sans text-gray-100 shadow-2xl sm:p-6"
>
  <div
    class="flex flex-col justify-between gap-3 border-b border-gray-800 pb-4 sm:flex-row sm:items-center"
  >
    <div>
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs font-bold text-amber-400 uppercase"
          >Curriculum Series</span
        >
        <span
          class="rounded border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-300 uppercase"
        >
          {
            seriesOrder === 0
              ? "Course Overview"
              : `Module ${seriesOrder} of ${seriesTotal}`
          }
        </span>
      </div>
      <h3 class="mt-1 text-lg font-black text-white">
        True Mastery of Terraform: A First-Principles Journey
      </h3>
    </div>

    <!-- Progress Pill -->
    <div
      class="flex items-center gap-2 self-start rounded-lg border border-gray-800 bg-gray-900 px-3 py-1.5 font-mono text-xs text-gray-300 sm:self-auto"
    >
      <span>Progress:</span>
      <strong class="text-amber-400">{progressPercent}%</strong>
    </div>
  </div>

  <!-- Next / Prev Buttons -->
  <div
    class="mt-4 flex flex-col items-center justify-between gap-3 text-xs font-semibold sm:flex-row"
  >
    {
      prevModule ? (
        <a
          href={`/posts/${prevModule.slug}/`}
          class="w-full rounded-lg border border-gray-800 bg-gray-900 px-4 py-2 text-center text-gray-300 transition hover:bg-gray-800 hover:text-white sm:w-auto"
        >
          &larr; Prev:{" "}
          {prevModule.order === 0
            ? "Master Hub"
            : `Module 0${prevModule.order}`}
        </a>
      ) : (
        <div class="hidden sm:block" />
      )
    }

    {
      nextModule ? (
        <a
          href={`/posts/${nextModule.slug}/`}
          class="w-full rounded-lg bg-amber-500 px-4 py-2 text-center font-bold text-black shadow-lg shadow-amber-500/20 transition hover:bg-amber-400 sm:w-auto"
        >
          Next: Module{" "}
          {nextModule.order < 10 ? `0${nextModule.order}` : nextModule.order}{" "}
          &rarr;
        </a>
      ) : (
        <div class="font-mono text-xs text-emerald-400">
          🎓 Curriculum Completed!
        </div>
      )
    }
  </div>

  <!-- Collapsible Complete Course Map -->
  <details class="group mt-4 border-t border-gray-800/80 pt-3 text-xs">
    <summary
      class="flex cursor-pointer items-center justify-between font-mono font-bold text-gray-400 transition hover:text-white"
    >
      <span>View All 12 Modules in this Journey</span>
      <span class="text-amber-400 transition-transform group-open:rotate-180"
        >&darr;</span
      >
    </summary>
    <div class="mt-3 grid grid-cols-1 gap-2 pt-2 md:grid-cols-2">
      {
        MODULE_TITLES.map(m => {
          const isCurrent = m.order === seriesOrder;
          return (
            <a
              href={`/posts/${m.slug}/`}
              class:list={[
                "flex items-center justify-between rounded-lg border p-2.5 font-sans text-xs transition",
                isCurrent
                  ? "border-amber-500/40 bg-amber-500/10 font-bold text-amber-300"
                  : "hover:bg-gray-850 border-gray-800/80 bg-gray-900/60 text-gray-400 hover:text-gray-200",
              ]}
            >
              <span class="line-clamp-1">{m.title}</span>
              {isCurrent && (
                <span class="rounded bg-amber-500/20 px-1.5 py-0.5 font-mono text-[10px] text-amber-400">
                  CURRENT
                </span>
              )}
            </a>
          );
        })
      }
    </div>
  </details>
</div>
