---
import type { MarkdownHeading } from "astro";

type Props = {
  headings?: MarkdownHeading[];
};

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{toc.length > 0 && (
  <nav class="doc-card p-4 text-xs font-sans">
    <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-800">
      <span class="font-bold uppercase tracking-wider text-slate-200 font-mono text-[11px] flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-sky-400"></span>
        Table of Contents
      </span>
      <span class="text-[10px] font-mono text-slate-500">TOC</span>
    </div>
    <ul class="space-y-1.5 border-l border-slate-800 pl-3">
      {toc.map((heading) => {
        const paddingLeft = (heading.depth - 2) * 0.75;
        return (
          <li>
            <a
              href={`#${heading.slug}`}
              class="block py-0.5 text-slate-400 hover:text-sky-400 transition-colors text-xs line-clamp-1"
              style={`padding-left: ${paddingLeft}rem`}
            >
              {heading.text}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}
