---
import type { MarkdownHeading } from "astro";

type Props = {
  headings?: MarkdownHeading[];
};

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{toc.length > 0 && (
  <nav class="py-6 ps-6">
    <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-muted-foreground">On this page</h2>
    <ul class="space-y-2 text-sm border-l border-border pl-4">
      {toc.map((heading) => {
        const paddingLeft = (heading.depth - 2) * 1;
        return (
          <li>
            <a
              href={`#${heading.slug}`}
              class="block py-1 text-foreground/70 hover:text-accent transition-colors"
              style={`padding-left: ${paddingLeft}rem`}
            >
              {heading.text}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}
