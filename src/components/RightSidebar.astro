---
import type { MarkdownHeading } from "astro";

type Props = {
  headings?: MarkdownHeading[];
};

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{toc.length > 0 && (
  <nav class="hud-card p-4 text-xs font-mono">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[rgba(0,240,255,0.15)]">
      <span class="font-bold uppercase tracking-wider text-[#00f0ff] flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-[#00f0ff] shadow-[0_0_6px_#00f0ff]"></span>
        // CONTENTS
      </span>
      <span class="text-[10px] text-slate-500">TOC</span>
    </div>
    <ul class="space-y-1.5 border-l border-[rgba(0,240,255,0.15)] pl-3">
      {toc.map((heading) => {
        const paddingLeft = (heading.depth - 2) * 0.75;
        return (
          <li>
            <a
              href={`#${heading.slug}`}
              class="block py-0.5 text-slate-400 hover:text-[#00f0ff] hover:hud-glow-text transition-colors font-sans text-xs line-clamp-1"
              style={`padding-left: ${paddingLeft}rem`}
            >
              {heading.text}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}
