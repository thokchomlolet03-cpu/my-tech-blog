---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import DomainBadge from "./DomainBadge.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const {
  title,
  description,
  tags = [],
  domain,
  format,
  series,
  seriesOrder,
  seriesTotal,
  ...props
} = data;
---

<li
  class="list-none border-b border-[rgba(230,235,245,0.10)] py-5 first:pt-0 last:border-0"
>
  <article class="flex flex-col gap-2">
    <!-- Top Taxonomy Badges -->
    <div class="flex items-center justify-between gap-2">
      <DomainBadge domain={domain} format={format} />
      {
        series && (
          <span class="rounded border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[9px] text-amber-300 uppercase">
            {seriesOrder === 0
              ? "SERIES HUB"
              : `MODULE ${seriesOrder} / ${seriesTotal}`}
          </span>
        )
      }
    </div>

    <!-- Title -->
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class="group focus-visible:outline-accent block"
    >
      <Heading
        transition:name={toTransitionName(title)}
        class="font-sans text-lg leading-snug font-bold tracking-tight text-white transition-colors duration-150 group-hover:text-[#a47bea] sm:text-xl"
      >
        {title}
      </Heading>
    </a>

    <!-- Metadata: Date & Tags -->
    <div
      class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-[#9ba0ad]"
    >
      <Datetime {...props} />
      <div class="flex flex-wrap items-center gap-1">
        {
          tags.map(tag => (
            <span
              class:list={[
                "rounded border px-1.5 py-0.5 font-mono text-[11px]",
                tag === "post-mortem"
                  ? "border-rose-800/40 bg-rose-950/40 text-rose-300"
                  : "border-[rgba(230,235,245,0.12)] bg-[#282c35] text-[#9ba0ad]",
              ]}
            >
              #{tag}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Excerpt / Body Copy -->
    <p
      class="mt-0.5 line-clamp-2 font-sans text-sm leading-relaxed text-[#9ba0ad]"
    >
      {description}
    </p>
  </article>
</li>
