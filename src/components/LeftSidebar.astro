---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { stripBase } from "@/utils/withBase";
import { getPostSlug } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// Get the current path to highlight the active link
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

type NavItem = {
  href: string;
  label: string;
  tag?: "post-mortem" | "default";
};

const primaryNav: NavItem[] = [
  { href: getRelativeLocaleUrl(locale, ""), label: "Overview" },
  { href: getRelativeLocaleUrl(locale, "posts"), label: "All Posts" },
  { href: getRelativeLocaleUrl(locale, "tags/post-mortem"), label: "Post-Mortems", tag: "post-mortem" },
  { href: getRelativeLocaleUrl(locale, "tags"), label: "Tags & Categories" },
  { href: getRelativeLocaleUrl(locale, "about"), label: "About" },
];

function isCurrentPath(href: string): boolean {
  // Strip the locale prefix and trailing slash for comparison
  const strippedHref = href.replace(/^\/[a-z]{2}(-[A-Z]{2})?\//, "/").replace(/\/$/, "") || "/";
  return pathWithoutTrailingSlash === strippedHref || pathWithoutTrailingSlash === "" && strippedHref === "/";
}
---

<nav class="py-2 text-xs font-sans" aria-label="Left sidebar navigation">
  <!-- Section Header -->
  <div class="px-3 pb-2 mb-1">
    <div class="flex items-center gap-2 py-1.5">
      <span class="size-1.5 rounded-full bg-[#a47bea] flex-shrink-0"></span>
      <span class="font-mono text-[10px] uppercase tracking-widest text-[#9ba0ad] font-medium">
        Navigation
      </span>
    </div>
  </div>

  <!-- Primary Nav Links -->
  <ul class="space-y-0.5 px-2" role="list">
    {primaryNav.map(({ href, label, tag }) => {
      const active = isCurrentPath(href);
      const isAlert = tag === "post-mortem";
      return (
        <li>
          <a
            href={href}
            class:list={[
              "flex items-center gap-2 w-full rounded px-2 py-1.5 text-xs font-normal leading-relaxed transition-all duration-150 truncate",
              active && !isAlert
                ? "bg-[#7e56c2]/20 text-[#a47bea] font-semibold border-l-2 border-[#a47bea] pl-[6px]"
                : active && isAlert
                ? "bg-rose-950/40 text-rose-300 font-semibold border-l-2 border-rose-500 pl-[6px]"
                : isAlert
                ? "text-rose-300/70 hover:text-rose-200 hover:bg-rose-950/20"
                : "text-[#9ba0ad] font-normal hover:text-white hover:bg-[rgba(230,235,245,0.06)]"
            ]}
            aria-current={active ? "page" : undefined}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Divider -->
  <div class="mx-3 my-3 border-t border-[rgba(230,235,245,0.10)]"></div>

  <!-- Recent Articles Section -->
  <div class="px-3 pb-1.5">
    <span class="font-mono text-[10px] uppercase tracking-widest text-[#9ba0ad] font-medium">
      Recent Articles
    </span>
  </div>

  <ul class="space-y-0.5 px-2" role="list">
    {sortedPosts.slice(0, 10).map((post) => {
      const postPath = `/posts/${getPostSlug(post.id, post.filePath)}`;
      const isActive = pathWithoutTrailingSlash === postPath;
      const isPostMortem = post.data.tags?.includes("post-mortem");
      return (
        <li>
          <a
            href={getRelativeLocaleUrl(locale, postPath)}
            title={post.data.title}
            class:list={[
              "block w-full rounded px-2 py-1 text-xs leading-snug transition-all duration-150 truncate",
              isActive
                ? "bg-[#7e56c2]/20 text-[#a47bea] font-medium border-l-2 border-[#a47bea] pl-[6px]"
                : isPostMortem
                ? "text-rose-300/60 hover:text-rose-200 hover:bg-rose-950/20"
                : "text-[#9ba0ad] font-normal hover:text-white hover:bg-[rgba(230,235,245,0.06)]"
            ]}
          >
            {post.data.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
