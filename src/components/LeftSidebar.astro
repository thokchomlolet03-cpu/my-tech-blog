---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { stripBase } from "@/utils/withBase";
import { getPostSlug } from "@/utils/getPostPaths";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");

// Get the current path to highlight the active link
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
---
<nav class="hud-card p-4 text-xs font-mono">
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-[rgba(0,240,255,0.15)]">
    <span class="font-bold uppercase tracking-wider text-[#00f0ff] flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-[#00f0ff] shadow-[0_0_6px_#00f0ff]"></span>
      // NAVIGATION
    </span>
    <span class="text-[10px] text-slate-500">HUD_V6</span>
  </div>

  <ul class="space-y-1">
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-all flex items-center gap-2", 
          pathWithoutTrailingSlash === "" ? "bg-[rgba(0,240,255,0.12)] text-[#00f0ff] font-semibold border-l-2 border-[#00f0ff]" : "hover:bg-[rgba(0,240,255,0.05)] hover:text-[#00f0ff] text-slate-300"
        ]}
      >
        <span>&gt;</span>
        <span>INDEX_OVERVIEW</span>
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "posts")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-all flex items-center gap-2", 
          pathWithoutTrailingSlash === "/posts" ? "bg-[rgba(0,240,255,0.12)] text-[#00f0ff] font-semibold border-l-2 border-[#00f0ff]" : "hover:bg-[rgba(0,240,255,0.05)] hover:text-[#00f0ff] text-slate-300"
        ]}
      >
        <span>&gt;</span>
        <span>ALL_DISPATCHES</span>
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "tags/post-mortem")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-all flex items-center gap-2", 
          pathWithoutTrailingSlash === "/tags/post-mortem" ? "bg-rose-950/40 text-rose-300 font-semibold border-l-2 border-rose-500" : "hover:bg-rose-950/20 hover:text-rose-300 text-rose-400/80"
        ]}
      >
        <span>&gt;</span>
        <span>POST_MORTEMS</span>
      </a>
    </li>

    <li class="pt-4">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-[rgba(0,240,255,0.1)]">
        <span class="font-bold uppercase tracking-wider text-slate-400 text-[10px] flex items-center gap-1.5">
          // RECENT LOGS
        </span>
      </div>
      <ul class="space-y-1">
        {posts.slice(0, 8).map((post) => {
           const postPath = `/posts/${getPostSlug(post.id, post.filePath)}`;
           const isActive = pathWithoutTrailingSlash === postPath;
           const isPostMortem = post.data.tags?.includes("post-mortem");
           return (
             <li>
               <a 
                 href={getRelativeLocaleUrl(locale, postPath)} 
                 class:list={[
                   "block w-full rounded px-2 py-1.5 transition-all line-clamp-1 font-sans text-xs", 
                   isActive ? "bg-[rgba(0,240,255,0.12)] text-[#00f0ff] font-semibold border-l-2 border-[#00f0ff]" : "hover:bg-[rgba(0,240,255,0.05)] hover:text-[#00f0ff] text-slate-400",
                   isPostMortem && !isActive ? "text-rose-400/80 hover:text-rose-300" : ""
                 ]}
                 title={post.data.title}
               >
                 {post.data.title}
               </a>
             </li>
           )
        })}
      </ul>
    </li>
  </ul>
</nav>
