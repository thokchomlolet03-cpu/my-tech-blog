---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { stripBase } from "@/utils/withBase";
import { getPostSlug } from "@/utils/getPostPaths";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");

// Get the current path to highlight the active link
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
---
<nav class="doc-card p-4 text-xs font-sans">
  <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-800">
    <span class="font-bold uppercase tracking-wider text-slate-200 font-mono text-[11px] flex items-center gap-2">
      <span class="size-1.5 rounded-full bg-sky-400"></span>
      Navigation
    </span>
    <span class="text-[10px] font-mono text-slate-500">MKDOCS</span>
  </div>

  <ul class="space-y-1">
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-colors flex items-center gap-2", 
          pathWithoutTrailingSlash === "" ? "bg-sky-950/40 text-sky-400 font-semibold border-l-2 border-sky-400" : "hover:bg-slate-800/60 hover:text-white text-slate-300"
        ]}
      >
        <span>Overview</span>
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "posts")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-colors flex items-center gap-2", 
          pathWithoutTrailingSlash === "/posts" ? "bg-sky-950/40 text-sky-400 font-semibold border-l-2 border-sky-400" : "hover:bg-slate-800/60 hover:text-white text-slate-300"
        ]}
      >
        <span>All Posts</span>
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "tags/post-mortem")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-colors flex items-center gap-2", 
          pathWithoutTrailingSlash === "/tags/post-mortem" ? "bg-rose-950/40 text-rose-300 font-semibold border-l-2 border-rose-500" : "hover:bg-rose-950/20 hover:text-rose-200 text-rose-300/80"
        ]}
      >
        <span>Post-Mortems</span>
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "tags")} 
        class:list={[
          "block w-full rounded px-2.5 py-1.5 transition-colors flex items-center gap-2", 
          pathWithoutTrailingSlash === "/tags" ? "bg-sky-950/40 text-sky-400 font-semibold border-l-2 border-sky-400" : "hover:bg-slate-800/60 hover:text-white text-slate-300"
        ]}
      >
        <span>Tags & Categories</span>
      </a>
    </li>

    <li class="pt-4">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800">
        <span class="font-bold uppercase tracking-wider text-slate-400 font-mono text-[10px]">
          Recent Articles
        </span>
      </div>
      <ul class="space-y-0.5">
        {posts.slice(0, 8).map((post) => {
           const postPath = `/posts/${getPostSlug(post.id, post.filePath)}`;
           const isActive = pathWithoutTrailingSlash === postPath;
           const isPostMortem = post.data.tags?.includes("post-mortem");
           return (
             <li>
               <a 
                 href={getRelativeLocaleUrl(locale, postPath)} 
                 class:list={[
                   "block w-full rounded px-2 py-1 transition-colors line-clamp-1 text-xs", 
                   isActive ? "bg-sky-950/40 text-sky-400 font-semibold border-l-2 border-sky-400" : "hover:bg-slate-800/60 hover:text-white text-slate-400",
                   isPostMortem && !isActive ? "hover:text-rose-300" : ""
                 ]}
                 title={post.data.title}
               >
                 {post.data.title}
               </a>
             </li>
           )
        })}
      </ul>
    </li>
  </ul>
</nav>
