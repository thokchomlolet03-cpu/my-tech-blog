---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { stripBase } from "@/utils/withBase";
import { getPostSlug } from "@/utils/getPostPaths";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");

// Get the current path to highlight the active link
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

// Basic grouping
---
<nav class="py-6 pe-6">
  <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-muted-foreground">Navigation</h2>
  <ul class="space-y-2 text-sm font-medium">
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "")} 
        class:list={["block w-full rounded-md px-3 py-2 transition-colors", pathWithoutTrailingSlash === "" ? "bg-accent/10 text-accent font-semibold" : "hover:bg-muted/50 hover:text-foreground text-foreground/80"]}
      >
        Home
      </a>
    </li>
    <li>
      <a 
        href={getRelativeLocaleUrl(locale, "posts")} 
        class:list={["block w-full rounded-md px-3 py-2 transition-colors", pathWithoutTrailingSlash === "/posts" ? "bg-accent/10 text-accent font-semibold" : "hover:bg-muted/50 hover:text-foreground text-foreground/80"]}
      >
        All Posts
      </a>
    </li>
    <li class="pt-4">
      <h3 class="mb-2 px-3 text-xs font-bold uppercase tracking-wider text-muted-foreground">Recent Posts</h3>
      <ul class="space-y-1">
        {posts.slice(0, 10).map((post) => {
           const postPath = `/posts/${getPostSlug(post.id, post.filePath)}`;
           const isActive = pathWithoutTrailingSlash === postPath;
           return (
             <li>
               <a 
                 href={getRelativeLocaleUrl(locale, postPath)} 
                 class:list={["block w-full rounded-md px-3 py-1.5 transition-colors line-clamp-2", isActive ? "bg-accent/10 text-accent font-semibold" : "hover:bg-muted/50 hover:text-foreground text-foreground/80"]}
                 title={post.data.title}
               >
                 {post.data.title}
               </a>
             </li>
           )
        })}
      </ul>
    </li>
  </ul>
</nav>
