---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const isPostMortem = tag === "post-mortem";
---

<li class="inline-block">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 transition-colors duration-150",
      isPostMortem
        ? "doc-badge-alert hover:border-rose-500 hover:text-rose-200"
        : "doc-badge hover:border-[#a47bea] hover:text-[#c499ff]",
      size === "sm" ? "px-2 py-0.5 text-[11px]" : "px-2.5 py-1 text-xs",
    ]}
  >
    <span class="text-slate-500">#</span>
    <span>{tagName}</span>
  </a>
</li>
