---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const isPostMortem = tag === "post-mortem";
---

<li class="inline-block">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "transition-colors duration-150 inline-flex items-center gap-1",
      isPostMortem ? "doc-badge-alert hover:border-rose-500 hover:text-rose-200" : "doc-badge hover:border-sky-500 hover:text-sky-300",
      size === "sm" ? "text-[11px] px-2 py-0.5" : "text-xs px-2.5 py-1",
    ]}
  >
    <span class="text-slate-500">#</span>
    <span>{tagName}</span>
  </a>
</li>
