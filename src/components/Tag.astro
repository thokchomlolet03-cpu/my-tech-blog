---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const isPostMortem = tag === "post-mortem";
---

<li class="inline-block">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "transition-all duration-200 hover:-translate-y-0.5 inline-flex items-center gap-1",
      isPostMortem ? "hud-badge-alert hover:shadow-[0_0_12px_rgba(244,63,94,0.4)]" : "hud-badge hover:border-cyan-400 hover:shadow-[0_0_12px_rgba(0,240,255,0.4)]",
      size === "sm" ? "text-[10px] px-2 py-0.5" : "text-xs px-3 py-1",
    ]}
  >
    <span class="opacity-60">#</span>
    <span>{tagName}</span>
  </a>
</li>
